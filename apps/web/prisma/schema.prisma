// Pomi's own records (docs/spec.md, section 7). Partial unique indexes and
// check constraints cannot be written here; they are SQL at the end of the
// migration that adds them, and each is named in a comment on its model.
// Prisma leaves them in place when it generates a later migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestKind {
  SINGLE
  REUSABLE
}

enum AmountKind {
  FIXED
  OPEN
}

enum RequestStatus {
  OPEN
  PAID
  CLOSED
}

// Whether a funding intent can still take payment for its request.
enum IntentState {
  OPEN
  CLOSED
}

// users_handle_format: the format parseHandle enforces in packages/shared.
// users_email_lowercase.
model User {
  id          String   @id
  // Stored lowercase.
  email       String   @unique
  // Chosen after the first sign-in, so absent until then.
  handle      String?  @unique
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  payoutAddresses PayoutAddress[]
  requests        Request[]
  sessions        Session[]

  @@map("users")
}

// sign_in_codes_email_lowercase.
// Only the newest code for an address counts; earlier ones stop working.
model SignInCode {
  id         String    @id
  // Stored lowercase. No user row exists until the first code is entered.
  email      String
  // An HMAC of the address and the code, keyed by AUTH_SECRET, so a copy of
  // the table does not reveal live codes.
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @map("created_at")

  @@index([email, createdAt])
  @@map("sign_in_codes")
}

model Session {
  id        String    @id
  userId    String    @map("user_id")
  // A SHA-256 of the token the client holds; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

// payout_addresses_one_active_per_user: a partial unique index on user_id.
// payout_addresses_stellar_account: the address is a Stellar account (G...).
model PayoutAddress {
  id         String    @id
  userId     String    @map("user_id")
  address    String
  active     Boolean   @default(true)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id])
  requests Request[]

  @@index([userId])
  @@map("payout_addresses")
}

// requests_amount_matches_kind: FIXED has an amount and no minimum; OPEN has
//   no amount.
// requests_amounts_positive, requests_single_is_fixed,
// requests_pay_box_is_reusable, requests_note_length.
// requests_one_pay_box_per_user: a partial unique index on user_id.
model Request {
  id              String        @id
  userId          String        @map("user_id")
  kind            RequestKind
  amountKind      AmountKind    @map("amount_kind")
  // Stellar amounts: up to 12 whole digits and 7 decimal places.
  amount          Decimal?      @db.Decimal(19, 7)
  minimumAmount   Decimal?      @map("minimum_amount") @db.Decimal(19, 7)
  // A Useroutr asset id, such as asset_usdc_stellar.
  assetId         String        @map("asset_id")
  // The address the request pays, fixed when it is created: what a payer
  // was shown is where the money goes, even if the receiver changes address.
  payoutAddressId String        @map("payout_address_id")
  note            String?
  // Shown on the receiver's handle page.
  listed          Boolean       @default(false)
  // The handle page's own pay box.
  payBox          Boolean       @default(false) @map("pay_box")
  status          RequestStatus @default(OPEN)
  endsAt          DateTime?     @map("ends_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  closedAt        DateTime?     @map("closed_at")

  user          User             @relation(fields: [userId], references: [id])
  payoutAddress PayoutAddress    @relation(fields: [payoutAddressId], references: [id])
  intents       RequestIntent[]
  payments      RequestPayment[]

  @@index([userId, status])
  @@map("requests")
}

// request_intents_one_open_exclusive: a partial unique index on request_id,
//   for exclusive intents in the OPEN state.
// request_intents_visit_matches_kind: an exclusive intent has no visit; any
//   other has one.
// request_intents_amount_positive.
model RequestIntent {
  id              String      @id
  requestId       String      @map("request_id")
  fundingIntentId String      @unique @map("funding_intent_id")
  fundingToken    String      @map("funding_token")
  // The visit a per-visitor intent belongs to. A single-use request's
  // intent is shared by every visitor, so it has none.
  visitId         String?     @map("visit_id")
  // What the intent asks for; for an open amount, what the payer chose.
  amount          Decimal     @db.Decimal(19, 7)
  // Set for a single-use request's intent, which every visitor shares.
  exclusive       Boolean
  state           IntentState @default(OPEN)
  // When Useroutr stops taking payment for the intent.
  expiresAt       DateTime    @map("expires_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  closedAt        DateTime?   @map("closed_at")

  request Request @relation(fields: [requestId], references: [id])

  @@unique([requestId, visitId])
  @@map("request_intents")
}

// request_payments_amount_positive.
model RequestPayment {
  id                        String   @id
  requestId                 String   @map("request_id")
  // One credited funding intent counts as one payment, however often its
  // webhook arrives.
  fundingIntentId           String   @unique @map("funding_intent_id")
  amount                    Decimal  @db.Decimal(19, 7)
  assetId                   String   @map("asset_id")
  // The payer's transaction, and the one that paid the receiver.
  paymentTransactionHash    String?  @map("payment_transaction_hash")
  settlementTransactionHash String?  @map("settlement_transaction_hash")
  creditedAt                DateTime @map("credited_at")

  request Request       @relation(fields: [requestId], references: [id])
  emails  OutboxEmail[]

  @@index([requestId])
  @@map("request_payments")
}

enum EmailKind {
  PAYMENT_RECEIVED
}

// Written in the same transaction as the change it reports, and sent after
// the commit, so a failed send never fails or repeats that change. One email
// of each kind per payment, however often the webhook arrives.
// outbox_emails_unsent: a partial index for the sender's query.
model OutboxEmail {
  id               String    @id
  kind             EmailKind
  requestPaymentId String    @map("request_payment_id")
  attempts         Int       @default(0)
  // A sender holds the email until then, so two senders never both send it.
  claimedUntil     DateTime? @map("claimed_until")
  sentAt           DateTime? @map("sent_at")
  createdAt        DateTime  @map("created_at")

  requestPayment RequestPayment @relation(fields: [requestPaymentId], references: [id])

  @@unique([kind, requestPaymentId])
  @@map("outbox_emails")
}

model Refund {
  // Useroutr's refund id.
  id                    String    @id
  fundingIntentId       String    @map("funding_intent_id")
  // Useroutr's refund status as last reported.
  status                String
  destinationRequiredAt DateTime? @map("destination_required_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([fundingIntentId])
  @@map("refunds")
}

model WebhookEvent {
  // The Useroutr-Event-Id header: a delivery that comes again is refused here.
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@map("webhook_events")
}
