# Copy to apps/web/.env and fill in. Never commit the copy.

# Postgres for Pomi's own records. Locally a database of your own; deployed, Neon.
DATABASE_URL=postgresql://pomi:pomi@localhost:5436/pomi

# Where Pomi is served, for links in emails and shared requests.
APP_URL=http://localhost:3000

# Keys the HMAC over stored sign-in codes. At least 32 characters; make one with
# openssl rand -base64 32
AUTH_SECRET=

# How sign-in codes are sent. "console" writes them to the dev server's output,
# for local development only; a production build refuses it. Deployed, use
# "resend", with an API key and a sender on a domain Resend has verified.
EMAIL_DELIVERY=console
# RESEND_API_KEY=re_replace_me
# EMAIL_FROM=Pomi <hello@pomi.app>

# A Useroutr application key, from the Useroutr dashboard. A ur_test_ key uses the
# sandbox (Stellar testnet), a ur_live_ key production (mainnet). Server only.
USEROUTR_API_KEY=ur_test_replace_me

# The signing secret of Pomi's webhook endpoint in that same Useroutr environment.
USEROUTR_WEBHOOK_SECRET=replace_me

# Optional. Lets payers pair a phone wallet over WalletConnect in the checkout.
# The project's allowlist must include APP_URL's domain.
# WALLETCONNECT_PROJECT_ID=

# Optional. The bearer token the scheduler sends to /api/jobs/send-emails, at
# least 32 characters. Without it the job refuses to run.
# CRON_SECRET=

# Optional. Horizon for the payout address checks; by default SDF's server for
# the Useroutr environment's network.
# STELLAR_HORIZON_URL=

# Only to develop against a Useroutr running on this machine, such as
# http://localhost:4000. Deployed, the key alone decides the API.
# USEROUTR_API_URL=

# Required in a production build: the request header the host sets to the
# client's IP address (x-real-ip on Vercel), for the checkout limits. A header
# the client can set is no proof, so leave it unset locally.
# CLIENT_IP_HEADER=x-real-ip

# Optional. Who is emailed when a refund needs a destination (spec section 9).
# OPERATOR_EMAIL=

# Optional. Sent with Expo push requests when the Expo project requires it.
# EXPO_ACCESS_TOKEN=
