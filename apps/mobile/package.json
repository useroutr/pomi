{
  "name": "@pomi/mobile",
  "private": true,
  "version": "0.0.0",
  "description": "Pomi for iOS and Android: create requests, share them, and get told when you are paid",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@pomi/shared": "workspace:*",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "6.0.3"
  }
}
